# =============================================================================
# AtcoGenie AI Engine — Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=AtcoGenie-AI
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG                    # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:5173,http://localhost:5256  # React dev, .NET backend

# --- LLM Provider ---
LLM_PROVIDER=openai                    # openai | google
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4.1                   # Primary model for SQL generation
OPENAI_FALLBACK_MODEL=gpt-4o           # Fallback model
GOOGLE_API_KEY=                        # Gemini API key (if using google provider)
GOOGLE_MODEL=gemini-2.5-flash          # Gemini model name

# --- Database: Pharma CRM (MS SQL) ---
PHARMA_DB_HOST=10.10.0.88
PHARMA_DB_PORT=1433
PHARMA_DB_NAME=PharmaCRM
PHARMA_DB_USER=dakiadbreader
PHARMA_DB_PASSWORD=your-pharma-password
PHARMA_DB_DRIVER=ODBC Driver 18 for SQL Server
PHARMA_POOL_MIN=2
PHARMA_POOL_MAX=10

# --- Database: SAP HANA ---
SAP_DB_HOST=sap-hana-host
SAP_DB_PORT=30015
SAP_DB_USER=sap_reader
SAP_DB_PASSWORD=your-sap-password
SAP_EXECUTOR_WORKERS=4                 # ThreadPoolExecutor size for sync hdbcli

# --- Database: Third-Party (MS SQL) ---
THIRDPARTY_DB_HOST=10.10.0.88
THIRDPARTY_DB_PORT=1433
THIRDPARTY_DB_NAME=ThirdPartyDB
THIRDPARTY_DB_USER=dakiadbreader
THIRDPARTY_DB_PASSWORD=your-thirdparty-password
THIRDPARTY_DB_DRIVER=ODBC Driver 18 for SQL Server
THIRDPARTY_POOL_MIN=2
THIRDPARTY_POOL_MAX=10

# --- Database: PostgreSQL (Checkpointer + IMD) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=AtcoGenie_Checkpoints
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IMD_DB=AtcoGenie_IMD                   # Identity Mapping Database (shared with .NET)

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_ROLE_CACHE_TTL=900               # 15 minutes for role cache
REDIS_SESSION_TTL=1800                 # 30 minutes for conversation session

# --- Active Directory ---
AD_SERVER=ldap://dc01.atcolab.local
AD_BASE_DN=DC=atcolab,DC=local
AD_DOMAIN=ATCO

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480                 # 8 hours

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=300

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atcogenie-production
LANGSMITH_TRACING=false                # Enable in production
